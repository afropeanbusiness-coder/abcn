# Neon Database & Auth Configuration
NEXT_PUBLIC_NEON_AUTH_URL=https://<your-neon-endpoint>.neonauth.<region>.aws.neon.tech/<database-name>/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://<your-neon-endpoint>.apirest.<region>.aws.neon.tech/<database-name>/rest/v1

# Optional Postgres connection string (if running scripts directly via psql / node-postgres)
DATABASE_URL=postgresql://<user>:<password>@<your-neon-endpoint>.<region>.aws.neon.tech/<database-name>?sslmode=require

# Email Service (Resend - Recommended)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_123456789...
# Sender email (requires verified domain in Resend, or use "onboarding@resend.dev" for testing)
EMAIL_FROM=ABCN Executive Team <contact@afropeanbusiness.com>
# Notification email for incoming submissions
ADMIN_NOTIFY_EMAIL=afropeanbusiness@gmail.com

# Custom SMTP Fallback (Optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

